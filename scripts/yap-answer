#!/usr/bin/env bash
# Usage: yap-answer <request_id>
# Poll a question (GET /v1/questions/:request_id). Prints the API response.
# 2s timeout. Missing env is silent success.
set -euo pipefail
if [[ -z "${YAP_API_URL:-}" || -z "${YAP_API_KEY:-}" ]]; then
  exit 0
fi
if [[ -z "${1:-}" ]]; then
  exit 0
fi
curl --silent --show-error --max-time 2 \
  -X GET "$YAP_API_URL/v1/questions/$1" \
  -H "authorization: Bearer $YAP_API_KEY" || true
echo
