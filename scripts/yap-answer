#!/usr/bin/env bash
# Usage: yap-answer <request_id> [--once]
# Poll GET /v1/questions/:request_id every 5 seconds until the status is
# answered, expired, or cancelled. --once does a single GET.
# A missing key is reported; the script still exits 0.
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1091
source "${script_dir}/lib/yap-env.sh"
# shellcheck disable=SC1091
source "${script_dir}/lib/yap-http.sh"

if ! yap_prepare; then
  exit 0
fi

once=0
request_id=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --once)
      once=1
      shift
      ;;
    *)
      if [[ -z "$request_id" ]]; then
        request_id="$1"
      fi
      shift
      ;;
  esac
done

if [[ -z "$request_id" ]]; then
  exit 0
fi

interval="${YAP_POLL_INTERVAL_S:-5}"

fetch_question() {
  local out="$1"
  : >"$out"
  yap_http_call once GET "/v1/questions/${request_id}" "" answer >"$out"
}

question_status() {
  local out="$1"
  node -e '
    const fs = require("fs");
    try {
      const body = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
      if (body && typeof body.status === "string") process.stdout.write(body.status);
    } catch (e) {}
  ' "$out"
}

out=$(mktemp)
trap 'rm -f "$out"' EXIT

if [[ "$once" -eq 1 ]]; then
  fetch_question "$out"
  cat "$out"
  exit 0
fi

while true; do
  fetch_question "$out"
  code="${YAP_HTTP_CODE:-000}"
  if [[ "$code" =~ ^4 ]]; then
    cat "$out"
    exit 0
  fi
  status=$(question_status "$out")
  case "$status" in
    answered|expired|cancelled)
      cat "$out"
      exit 0
      ;;
  esac
  sleep "$interval" || exit 0
done
