#!/usr/bin/env bash
# Usage: yap-answer <request_id>
# Poll a question (GET /v1/questions/:request_id). Prints the API response.
# Timeouts, network errors, and 5xx retry in the background.
# A missing key is reported; the script still exits 0.
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1091
source "${script_dir}/lib/yap-env.sh"
# shellcheck disable=SC1091
source "${script_dir}/lib/yap-http.sh"

if ! yap_prepare; then
  exit 0
fi
if [[ -z "${1:-}" ]]; then
  exit 0
fi
yap_http_call print GET "/v1/questions/$1" "" answer
