#!/usr/bin/env bash
# Usage: yap-pair <code>
# Pair with the code on the glass (POST /v1/pair). Prints the API response.
# Timeouts, network errors, and 5xx retry in the background. Missing env is silent success.
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1091
source "${script_dir}/lib/yap-http.sh"

if [[ -z "${YAP_API_URL:-}" || -z "${YAP_API_KEY:-}" ]]; then
  exit 0
fi
if [[ -z "${1:-}" ]]; then
  exit 0
fi
body=$(node -e 'process.stdout.write(JSON.stringify({ code: process.argv[1] }));' "$1")
yap_http_call print POST /v1/pair "$body" pair
