#!/usr/bin/env bash
# Usage: yap-ask "question" ['{"any":"json"}']
# Prints the API response. Timeouts, network errors, and 5xx retry in the
# background; 4xx does not. Missing env is silent success.
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1091
source "${script_dir}/lib/yap-http.sh"

if [[ -z "${YAP_API_URL:-}" || -z "${YAP_API_KEY:-}" ]]; then
  exit 0
fi
if [[ -z "${1:-}" ]]; then
  exit 0
fi
body=$(node -e 'const [question,context]=process.argv.slice(1); const body={question}; if(context) body.context=JSON.parse(context); process.stdout.write(JSON.stringify(body));' "$1" "${2:-}")
yap_http_call print POST /v1/ask "$body" ask
